          {
            "name": "If-Modified-Since",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "visibility",
            "in": "query",
            "description": "Only the links of the visibility.",
            "schema": {
              "$ref": "#/components/schemas/docVisibility"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",

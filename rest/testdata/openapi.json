          "links"
        ],
        "operationId": "links.list",
        "parameters": [
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 3
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "How many links to return.",

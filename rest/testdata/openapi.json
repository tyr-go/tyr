  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "description": "The URI reference of the problem type: one per kind, or about:blank for a problem of the HTTP request itself."
          },
          "title": {
            "type": "string",
            "description": "The title of the problem type."
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status."
          },
          "detail": {
            "type": "string",
            "description": "The message of the error."
          },
          "kind": {
            "type": "string",
            "description": "The kind of the error. A problem of the HTTP request itself has none.",
            "enum": [
              "internal",
              "invalid_argument",
              "unauthenticated",
              "permission_denied",
              "not_found",
              "already_exists",
              "failed_precondition",
              "resource_exhausted",
              "deadline_exceeded",
              "unavailable",
              "canceled"
            ]
          },
          "errors": {
            "type": "array",
            "description": "The fields that failed validation, with invalid_argument.",
            "items": {
              "$ref": "#/components/schemas/Violation"
            }
          },
          "details": {
            "description": "The details of an error of another kind."
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "Violation": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "description": "A JSON Pointer to the field in the JSON form of the request, such as /code."
          },
          "detail": {
            "type": "string",
            "description": "What's wrong with the field."
          }
        },
        "required": [
          "pointer",
          "detail"
        ]
      },
      "docCreated": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The code of the link."
          },
          "url": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "visibility": {
            "description": "Who may follow the link.",
            "allOf": [
              {
                "$ref": "#/components/schemas/docVisibility"
              }
            ]
          }
        },
        "required": [
          "code",
          "url",
          "created_at",
          "visibility"
        ]
      },
      "docImported": {
        "type": "object",
        "properties": {
          "imported": {
            "type": "integer"
          }
        },
        "required": [
          "imported"
        ]
      },
      "docLink": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The code of the link."
          },
          "url": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "visibility": {
            "description": "Who may follow the link.",
            "allOf": [
              {
                "$ref": "#/components/schemas/docVisibility"
              }
            ]
          }
        },
        "required": [
          "code",
          "url",
          "created_at",
          "visibility"
        ]
      },
      "docLinkInput": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The code of the link."
          },
          "url": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "visibility": {
            "description": "Who may follow the link.",
            "allOf": [
              {

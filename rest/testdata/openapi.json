                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "/problems/invalid_argument"
                        },
                        "kind": {
                          "const": "invalid_argument"
                        }
                      },
                      "required": [
                        "type",
                        "kind"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "An error of another kind, or a problem of the HTTP request itself.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "links"
        ],
        "summary": "Create a link",
        "description": "Without a code, the link gets a random one.",
        "operationId": "links.create",
        "parameters": [
          {
            "name": "X-Tenant",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "examples": {
              "with a code": {
                "value": "acme"
              }
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Where the link leads.",
                    "minLength": 1,
                    "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#]"
                  },
                  "code": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 16
                  }
                },
                "required": [
                  "url"
                ]
              },
              "examples": {
                "with a code": {
                  "value": {
                    "url": "https://go.dev",
                    "code": "go-home"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "description": "The path of the link.",
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "with a code": {
                    "value": "/links/go-home"
                  }
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/docCreated"
                },
                "examples": {
                  "with a code": {
                    "value": {
                      "code": "go-home",
                      "url": "https://go.dev",
                      "created_at": "2026-09-24T00:00:00Z",
                      "visibility": "public"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid Argument",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "/problems/invalid_argument"
                        },
                        "kind": {
                          "const": "invalid_argument"
                        }
                      },
                      "required": [
                        "type",
                        "kind"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Already Exists or Failed Precondition",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "enum": [
                            "/problems/already_exists",
                            "/problems/failed_precondition"
                          ]
                        },
                        "kind": {
                          "enum": [
                            "already_exists",
                            "failed_precondition"
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "kind"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "An error of another kind, or a problem of the HTTP request itself.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
